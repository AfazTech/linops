{
    "name": "afaztech/linops",
    "description": "asynchronous PHP library for Linux server management over SSH",
    "type": "library",
    "license": "MIT",
    "keywords": ["linux", "ssh", "async", "amp", "server-management", "monitoring"],
    "require": {
        "php": ">=8.2",
        "amphp/amp": "^3.0",
        "amphp/sync": "^2.0",
        "amphp/pipeline": "^1.0",
        "amphp/process": "^2.0",
        "amphp/byte-stream": "^2.0",
        "phpseclib/phpseclib": "^3.0",
        "revolt/event-loop": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "AfazTech\\LinOps\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AfazTech\\LinOps\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
